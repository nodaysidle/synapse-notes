# Local Supabase Edge Function configuration.
# Store the live OPENROUTER_API_KEY with Supabase function secrets; never expose it to Vite or the APK.
OPENROUTER_API_KEY=sk-or-v1-your-key

OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
OPENROUTER_TRANSCRIPTION_FALLBACK_MODELS=openai/whisper-large-v3,google/chirp-3

OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-001
OPENROUTER_EMBEDDING_DIMENSIONS=768

OPENROUTER_IMAGE_MODEL=krea/krea-2-medium-turbo
OPENROUTER_IMAGE_FALLBACK_MODELS=google/gemini-3.1-flash-lite-image

OPENROUTER_QA_MODEL=openai/gpt-5.6-luna
OPENROUTER_QA_FALLBACK_MODELS=google/gemini-2.5-flash-lite
