# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Edge Function secrets, set with:
# supabase secrets set TRANSCRIPTION_PROVIDER=gemini GOOGLE_API_KEY=...
TRANSCRIPTION_PROVIDER=gemini
GOOGLE_API_KEY=your-google-ai-studio-key
IMAGEN_MODEL=imagen-4.0-generate-001

# Image generation defaults to Replicate FLUX Schnell for low-cost note visuals.
IMAGE_PROVIDER=replicate
REPLICATE_API_TOKEN=r8_your-replicate-token
REPLICATE_MODEL=black-forest-labs/flux-schnell

# Optional transcription fallbacks, only used if TRANSCRIPTION_PROVIDER is changed.
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1
GROQ_API_KEY=gsk_your-key
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
